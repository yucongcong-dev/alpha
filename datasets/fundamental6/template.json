{
  "_comment": "fundamental6 独立模板库 — broad seed 按时间变化、行业相对值、规模桶和字段更新事件四个 family 分散；时序窗口使用官方推荐值(5/20/60/120/252)，模板内不重复 settings 中性化",
  "_comment_placeholders": "{field}=字段名, {field_preprocessed}=winsorize(ts_backfill({field}, {backfill_window}), std=4), {field_longfill}=winsorize(ts_backfill({field}, 252), std=3), {field_rawfill}=ts_backfill({field}, {backfill_window}), {backfill_window}=settings.yaml expression.backfill_window",
  "default": [
    {
      "_comment": "=== 时间变化强度：关注慢频基本面变化相对自身波动 ===",
      "name": "seed_delta_over_std_63_126",
      "expression": "rank(ts_delta({field_preprocessed}, 63) / ts_std_dev({field_preprocessed}, 126))",
      "priority": 1000,
      "family": "delta_over_std",
      "layer": "time_series",
      "stage": "first_order",
      "role": "default_seed",
      "activation_scope": "broad"
    },
    {
      "_comment": "=== 行业相对值：控制横截面行业结构差异 ===",
      "name": "seed_industry_zscore_120",
      "expression": "group_rank(ts_zscore({field_preprocessed}, 120), industry)",
      "priority": 998,
      "family": "grouped_zscore",
      "layer": "group",
      "stage": "group_second_order",
      "role": "default_seed",
      "activation_scope": "broad"
    },
    {
      "_comment": "=== 规模桶相对排序：避免直接除以 cap 的量纲与极值问题 ===",
      "name": "seed_cap_bucket_ts_rank_120",
      "expression": "group_rank(ts_rank({field_preprocessed}, 120), densify(bucket(rank(cap), range='0.1, 1, 0.1')))",
      "priority": 996,
      "family": "bucket_ts_rank",
      "layer": "group",
      "stage": "group_second_order",
      "role": "default_seed",
      "activation_scope": "broad"
    },
    {
      "_comment": "=== 字段更新事件：只在近期基本面数据发生变化时持有信号 ===",
      "name": "seed_change_event_delta_over_std_20_120",
      "expression": "trade_when(days_from_last_change({field}) <= 20, rank(ts_delta({field_preprocessed}, 20) / ts_std_dev({field_preprocessed}, 120)), -1)",
      "priority": 994,
      "family": "event_delta_over_std",
      "layer": "event",
      "stage": "event_conditioned",
      "role": "default_seed",
      "activation_scope": "broad"
    }
  ],
  "VECTOR": [
    {
      "_comment": "=== VECTOR: 默认事件种子只保留字段自身变化路径 ===",
      "name": "event_trade_when_recent_change_zscore_60",
